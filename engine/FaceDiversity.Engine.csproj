<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>facediv</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.52.0" />
    <PackageReference Include="YamlDotNet" Version="15.1.2" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" /> <!-- BSA v105 LZ4 frames; same version Mutagen's reader uses -->
  </ItemGroup>
</Project>
